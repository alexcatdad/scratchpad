{
  "name": "scratchpad",
  "kind": "deployment",
  "repository": "alexcatdad/scratchpad",
  "port": 3000,
  "dockerfile": "Dockerfile",
  "target": "go-runtime",
  "deployment": {
    "namespace": "app-scratchpad",
    "name": "scratchpad",
    "container": "scratchpad",
    "service": "scratchpad",
    "smokePath": "/ready",
    "smokeJSON": {
      "database": "postgres"
    },
    "predeployDump": true,
    "rolloutTimeoutSeconds": 660
  }
}

{
  "//": "Linux container for Go backend and npm workspace work. macOS-only parts (Swift app in macos/, code signing and notarization) do not work here.",
  "name": "scratchpad (Go)",
  "image": "mcr.microsoft.com/devcontainers/go:1.27@sha256:32aad7e9eefed4fe99987cc4efef2f9723bd57c556f171143ecf65e0ba855ff3",
  "features": {
    "ghcr.io/devcontainers-extra/features/go-task:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "24" }
  },
  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "scratchpad (npm run dev)" } },
  "postCreateCommand": "go -C backend mod download"
}

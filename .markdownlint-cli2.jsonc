{
  "globs": ["**/*.md", "**/*.mdx"],
  "ignores": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.astro/**",
    "test-results/**",
    "playwright-report/**"
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD024": false,
    "MD025": false,
    "MD033": false,
    "MD041": false,
    "MD060": false
  }
}

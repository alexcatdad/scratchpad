{
  "schema": "release-tools/app/v1",
  "app": "scratchpad",
  "repo": "alexcatdad/scratchpad",
  "checks": ["check"],
  "targets": [
    {
      "id": "darwin-arm64",
      "os": "darwin",
      "arch": "arm64",
      "min_os": "13.0",
      "runs": "local",
      "build_task": "build:darwin-arm64",
      "validate_task": "validate:darwin-arm64",
      "artifacts": [{ "name": "scratchpad-mcp-v{version}-darwin-arm64.zip", "kind": "zip" }]
    },
    {
      "id": "darwin-amd64",
      "os": "darwin",
      "arch": "amd64",
      "min_os": "13.0",
      "runs": "local",
      "build_task": "build:darwin-amd64",
      "artifacts": [{ "name": "scratchpad-mcp-v{version}-darwin-amd64.zip", "kind": "zip" }]
    },
    {
      "id": "linux-arm64",
      "os": "linux",
      "arch": "arm64",
      "min_os": "fedora-42",
      "runs": "any",
      "build_task": "build:linux-arm64",
      "artifacts": [{ "name": "scratchpad-mcp-v{version}-linux-arm64.tar.gz", "kind": "tar.gz" }]
    },
    {
      "id": "linux-amd64",
      "os": "linux",
      "arch": "amd64",
      "min_os": "fedora-42",
      "runs": "any",
      "build_task": "build:linux-amd64",
      "artifacts": [{ "name": "scratchpad-mcp-v{version}-linux-amd64.tar.gz", "kind": "tar.gz" }]
    }
  ],
  "migration": { "floor": "0.3.0" },
  "signing": {
    "macos": {
      "targets": ["darwin-arm64", "darwin-amd64"],
      "notarize": true
    }
  },
  "tap": {
    "repo": "alexcatdad/homebrew-tap",
    "kind": "formula",
    "package": "scratchpad-mcp"
  },
  "deploy": { "task": "deploy:image" }
}

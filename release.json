{
  "schema": "release-tools/app/v1",
  "app": "scratchpad",
  "repo": "alexcatdad/scratchpad",
  "checks": ["check"],
  "targets": [
    {
      "id": "darwin-arm64",
      "os": "darwin",
      "arch": "arm64",
      "min_os": "13.0",
      "runs": "local",
      "build_task": "build:darwin-arm64",
      "validate_task": "validate:darwin-arm64",
      "artifacts": [
        {
          "name": "scratchpad-{version}-darwin-arm64.zip",
          "kind": "zip"
        }
      ]
    }
  ],
  "migration": { "floor": "0.3.0" },
  "signing": {
    "macos": {
      "targets": ["darwin-arm64"],
      "notarize": true,
      "staple": true
    }
  },
  "tap": {
    "repo": "alexcatdad/homebrew-tap",
    "kind": "cask",
    "package": "scratchpad"
  }
}

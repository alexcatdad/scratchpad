{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.astro",
      "!**/.output",
      "!**/.tanstack",
      "!**/test-results",
      "!**/playwright-report",
      "!**/routeTree.gen.ts",
      "!**/go.sum",
      "!**/package-lock.json",
      "!packages/clients/typescript/schema.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}

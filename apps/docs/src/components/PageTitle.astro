---
// biome-ignore-all lint/correctness/noUnusedImports lint/correctness/noUnusedVariables: Astro templates consume these frontmatter bindings.
const { title, description } = Astro.locals.starlightRoute.entry.data;
---

<div class="article-heading">
  <h1 id="_top">{title}</h1>
  {description && <p>{description}</p>}
</div>

<style>
  .article-heading h1 {
    margin: 0;
    font-family: var(--sp-display);
    font-size: var(--sl-text-h1);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--sl-color-white);
  }
  .article-heading p {
    margin-top: 1rem;
    color: var(--sl-color-gray-3);
    font-size: 1.075rem;
    line-height: 1.65;
    max-width: 45rem;
  }
</style>
